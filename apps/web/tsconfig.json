{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "preserve",
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@faultlab/simulation-client": ["../../packages/simulation-client/src/index.ts"],
      "@faultlab/simulation-client/*": ["../../packages/simulation-client/src/*"],
      "@faultlab/wasm": ["src/wasm/simulation_wasm.js"]
    }
  },
  "include": ["src", "../../packages/simulation-client/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
